# ============================================================
#  IBM watsonx.ai – Agentic Career Counselor
#  Copy this file to .env and fill in your credentials
# ============================================================

# IBM Cloud API Key  (IAM → Manage → API keys)
IBM_API_KEY=your_ibm_cloud_api_key_here

# watsonx.ai Project ID  (watsonx.ai → Manage → General → Project ID)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# watsonx.ai endpoint (choose the region closest to you)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model ID (IBM Lite – no charge for these)
GRANITE_MODEL_ID=ibm/granite-13b-chat-v2

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change_me_to_a_random_secret_string

# Flask environment  (development | production)
FLASK_ENV=development

# Port the app listens on
PORT=5000
